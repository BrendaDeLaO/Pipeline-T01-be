// ============================================================
// SCRIPT DE IMPLEMENTACIÓN
// ============================================================

use("winesdb");

// ==================== CREAR COLECCIONES ====================

db.createCollection("user", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["full_name", "email", "password", "role", "is_active"],
      properties: {
        full_name:  { bsonType: "string" },
        email:      { bsonType: "string" },
        password:   { bsonType: "string" },
        role:       { bsonType: "string", enum: ["admin", "vendedor", "caja"] },
        created_at: { bsonType: "date" },
        deleted_at: { bsonType: ["date", "null"] },
        is_active:  { bsonType: "bool" }
      }
    }
  }
});
db.user.createIndex({ email: 1 }, { unique: true });

db.createCollection("customer", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["name", "last_name", "email", "state"],
      properties: {
        name:       { bsonType: "string" },
        last_name:  { bsonType: "string" },
        phone:      { bsonType: "string" },
        email:      { bsonType: "string" },
        address:    { bsonType: "string" },
        state:      { bsonType: "string", enum: ["Activo", "Inactivo"] },
        user_id:    { bsonType: ["objectId", "null"] },
        created_at: { bsonType: "date" }
      }
    }
  }
});
db.customer.createIndex({ email: 1 }, { unique: true });

db.createCollection("product", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["product_name", "product_size", "price", "product_category", "stock"], 
      properties: {
        code:                { bsonType: "string" },
        product_name:        { bsonType: "string" },
        product_size:        { bsonType: "number" }, 
        price:               { bsonType: "number" },
        product_category:    { bsonType: "string", enum: ["Vino", "Pisco", "Crema", "Brandy"] },
        product_description: { bsonType: "string" },
        awards:              { bsonType: "string" },
        vintage_year:        { bsonType: "int" },
        register_date:       { bsonType: "date" },
        series:              { bsonType: "string" },
        stock:               { bsonType: "int" },
        state:               { bsonType: "bool" },
        created_at:          { bsonType: "date" },
        updated_at:          { bsonType: ["date", "null"] },
        deleted_at:          { bsonType: ["date", "null"] },
        restored_at:         { bsonType: ["date", "null"] }
      }
    }
  }
});
db.product.createIndex({ code: 1 }, { unique: true });

db.createCollection("promotion", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["name", "discountPercent", "startDate", "endDate"],
      properties: {
        name:            { bsonType: "string" },
        description:     { bsonType: "string" },
        discountPercent: { bsonType: "number", minimum: 0, maximum: 100 },
        startDate:       { bsonType: "date" },
        endDate:         { bsonType: "date" }
      }
    }
  }
});

db.createCollection("tasting_event", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["event_name", "event_date", "max_capacity", "price_per_person", "state"],
      properties: {
        event_name:        { bsonType: "string" },
        event_description: { bsonType: "string" },
        event_date:        { bsonType: "date" },
        max_capacity:      { bsonType: "int", minimum: 1 },
        price_per_person:  { bsonType: "number", minimum: 0 },
        state:             { bsonType: "string", enum: ["Activo", "Cancelado", "Finalizado"] },
        created_at:        { bsonType: "date" },
        updated_at:        { bsonType: ["date", "null"] },
        deleted_at:        { bsonType: ["date", "null"] },
        restored_at:       { bsonType: ["date", "null"] }
      }
    }
  }
});

db.createCollection("location", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["address", "latitude", "longitude", "status", "tastingevent_id"],
      properties: {
        address:            { bsonType: "string" },
        ubigeo:             { bsonType: "string" },
        latitude:           { bsonType: "double" },
        longitude:          { bsonType: "double" },
        additional_details: { bsonType: "string" },
        status:             { bsonType: "bool" },
        tastingevent_id:    { bsonType: "objectId" }
      }
    }
  }
});

db.createCollection("product_promotion", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["promotion_id", "product_id"],
      properties: {
        promotion_id: { bsonType: "objectId" },
        product_id:   { bsonType: "objectId" }
      }
    }
  }
});

db.createCollection("sale", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["customer_id", "sale_date", "delivery_type", "payment_method"],
      properties: {
        customer_id:    { bsonType: "objectId" },
        sale_date:      { bsonType: "date" },
        delivery_type:  { bsonType: "string", enum: ["Delivery", "Recojo en tienda"] },
        payment_method: { bsonType: "string", enum: ["Efectivo", "Tarjeta", "Transferencia", "Yape", "Plin"] }
      }
    }
  }
});

db.createCollection("sale_detail", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["product_id", "sale_id", "quantity", "price_sale"],
      properties: {
        product_id: { bsonType: "objectId" },
        sale_id:    { bsonType: "objectId" },
        quantity:   { bsonType: "int", minimum: 1 },
        price_sale: { bsonType: "number", minimum: 0 }
      }
    }
  }
});

db.createCollection("sale_summaries", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["sale_id", "total_calculated_sale"],
      properties: {
        sale_id:               { bsonType: "objectId" },
        total_calculated_sale: { bsonType: "number", minimum: 0 }
      }
    }
  }
});

db.createCollection("reservation", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["status", "customer_id", "reservationDate", "numberOfPeople", "tastingevent_id"],
      properties: {
        status:          { bsonType: "string", enum: ["P", "C", "X"] },
        customer_id:     { bsonType: "objectId" },
        reservationDate: { bsonType: "date" },
        reservationTime: { bsonType: "date" },
        numberOfPeople:  { bsonType: "int", minimum: 1 },
        tastingevent_id: { bsonType: "objectId" }
      }
    }
  }
});

db.createCollection("reservation_guest", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["reservation_id", "first_name", "last_name", "status"],
      properties: {
        reservation_id: { bsonType: "objectId" },
        customer_id:    { bsonType: ["objectId", "null"] },
        first_name:     { bsonType: "string" },
        last_name:      { bsonType: "string" },
        email:          { bsonType: "string" },
        age:            { bsonType: "int", minimum: 18 },
        preferences:    { bsonType: "string" },
        status:         { bsonType: "bool" }
      }
    }
  }
});

